{
  "name": "themecc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "registry:check": "tsx scripts/registry-check.ts",
    "registry:check:remote": "tsx scripts/registry-check-remote.ts",
    "registry:build": "tsx scripts/registry-build.ts",
    "lint:fix": "biome check --write",
    "prebuild": "tsx scripts/sync-previews.ts",
    "predev": "tsx scripts/sync-previews.ts",
    "registry:seed": "tsx scripts/seed-registry.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.13.1",
  "description": "Gallery and registry of Claude Code desktop and CLI themes. Unofficial.",
  "engines": {
    "node": ">=26"
  }
}
